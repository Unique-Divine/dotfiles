#!/usr/bin/env bash
# git_merge_main: Merge origin/<base> into the current branch. Plain git does
# the clean cases; a conflict either stops cleanly or, with --agent, goes to an
# agent CLI with the instructions in git_merge_main.prompt.md.

set -Eeuo pipefail

usage() {
  cat <<EOF
Usage: git_merge_main [--base BRANCH] [--agent]

Bring the current branch up to date with origin/BRANCH (default: main).

  On BRANCH itself      fast-forward only
  On another branch     merge, creating a merge commit when needed
  Detached              switch to BRANCH when HEAD is already part of it

Exit codes:
  0  up to date
  2  uncommitted changes; nothing was touched
  3  needs judgment (conflict, or BRANCH diverged from origin); nothing was
     touched. Rerun with --agent to hand it to claude, or codex if claude is
     missing.
  4  detached at a commit that isn't on origin/BRANCH

Options:
  --base BRANCH  Branch to merge from (default: main).
  --agent        On exit 2 or 3, run an agent with the merge prompt instead.
  -h, --help     Show this help.
EOF
}

base=main
use_agent=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) base="${2:?--base needs a branch}"; shift 2 ;;
    --agent) use_agent=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

script_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
prompt_file="$script_dir/git_merge_main.prompt.md"
upstream="origin/$base"
repo="$(git rev-parse --show-toplevel)"

say() { echo "git_merge_main: $*" >&2; }

# Hand the merge to an agent CLI. Exits with the agent's status.
run_agent() {
  local -r reason="$1"
  local context
  context="$(printf '%s\n' \
    "" "## This Run" "" \
    "- Repository: $repo" \
    "- Base: $upstream" \
    "- Current branch: $(git branch --show-current)" \
    "- Why plain git stopped: $reason")"
  if command -v claude >/dev/null 2>&1; then
    say "handing the merge to claude"
    { cat "$prompt_file"; echo "$context"; } | claude -p \
      --permission-mode acceptEdits \
      --allowedTools "Bash(git:*)" "Bash(just:*)" "Bash(bun:*)" \
        "Bash(cargo:*)" "Read" "Edit" "Write" "Grep" "Glob"
  elif command -v codex >/dev/null 2>&1; then
    say "claude not found; handing the merge to codex"
    { cat "$prompt_file"; echo "$context"; } | codex exec -C "$repo" \
      -s workspace-write --approve-for-me
  else
    say "neither claude nor codex is installed (repair: just sync)"
    exit 1
  fi
}

# Stop with exit 3, or hand over to the agent.
needs_judgment() {
  local -r reason="$1"
  if (( use_agent )); then
    run_agent "$reason"
    exit $?
  fi
  say "$reason"
  say "nothing was changed; run: git_merge_main --agent"
  exit 3
}

if [[ -n "$(git status --porcelain)" ]]; then
  if (( use_agent )); then
    run_agent "the working tree has uncommitted changes"
    exit $?
  fi
  say "uncommitted changes in $repo; skipping"
  exit 2
fi

git fetch --quiet origin "+refs/heads/$base:refs/remotes/$upstream"

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
  if ! git merge-base --is-ancestor HEAD "$upstream"; then
    say "detached at $(git rev-parse --short HEAD), which isn't on $upstream; switch to a branch first"
    exit 4
  fi
  if git show-ref --verify --quiet "refs/heads/$base"; then
    git switch --quiet "$base"
  else
    git switch --quiet --create "$base" --track "$upstream"
  fi
  branch="$base"
fi

if [[ "$branch" == "$base" ]]; then
  if git merge --ff-only --quiet "$upstream" 2>/dev/null; then
    say "$base is at $(git rev-parse --short HEAD) ($upstream)"
    exit 0
  fi
  needs_judgment "$base has commits that $upstream doesn't, and the reverse"
fi

if git merge --no-edit --quiet "$upstream" >/dev/null 2>&1; then
  say "$branch now includes $upstream ($(git rev-parse --short "$upstream"))"
  exit 0
fi

conflicts="$(git diff --name-only --diff-filter=U | paste -sd ' ' -)"
git merge --abort
needs_judgment "merging $upstream into $branch conflicts in: ${conflicts:-unknown files}"
