#!/usr/bin/env bash
# git_mf: Git "[m]erge [f]rom". Bring the current branch up to date with
# origin/<target>. A read-only plan step decides what to do, using git's own
# merge engine (git merge-tree) to predict conflicts; an apply step runs it.
# Cases that need judgment stop cleanly, or with --agent go to an agent CLI
# with the instructions in git_mf.prompt.md.

set -Eeuo pipefail

usage() {
  cat <<EOF
Usage: git_mf [target_branch] [--dry-run] [--agent] [--json]
              [git merge flags...]

Git "[m]erge [f]rom". Bring the current branch up to date with
origin/TARGET, or with the local TARGET when origin doesn't have it.

  No target            fetch and pull the current branch
  On TARGET itself     fast-forward only
  On another branch    merge, creating a merge commit when needed
  Detached             switch to TARGET when HEAD is already part of it

A local TARGET branch you aren't on is fast-forwarded too, when it can be.

Every run prints its plan ("git_mf: plan: ...") and each command that
changes the repository ("RUN ..."). With --dry-run, nothing but
remote-tracking refs changes, and the exit code is the one a real run would
return.

Exit codes:
  0  up to date, or brought up to date
  1  error (TARGET missing, or a merge failed without conflicts)
  2  uncommitted changes; nothing was touched
  3  needs judgment (conflict, or TARGET diverged from origin); nothing was
     touched. Rerun with --agent to hand it to claude, or codex if claude is
     missing.
  4  detached at a commit that isn't on TARGET
  5  a merge, rebase, cherry-pick, or revert is already in progress

Options:
  --dry-run     Print the plan and commands without running them.
  --agent       On exit 2 or 3, run an agent with the merge prompt instead.
  --json        Print this run's events to stdout as JSONL. Command output
                moves to stderr. The agent's own events (from ud runs
                tap) are in the run file, not on stdout.
  -h, --help    Show this help.

Each run is logged to the Boku run log (~/.boku/runs; BOKU_HOME moves it,
BOKU_RUNLOG=0 turns it off). Read it with ud runs.
EOF
}

require_command() {
  local -r command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'ERROR: required command not found: %s\n' "$command_name" >&2
    exit 127
  fi
}

say() { echo "git_mf: $*" >&2; }

dry_run=0
json_out=0

# Print a command that changes the repository, then run it unless dry-run.
# Each one is a step in the run log. Under --json, the command's own output
# goes to stderr so stdout stays JSONL.
run() {
  echo "RUN $*" >&2
  if (( dry_run )); then
    runlog_event step name="$1 ${2:-}" msg=dry-run
    return 0
  fi
  if (( json_out )); then
    runlog_step "$1 ${2:-}" "$@" >&2
  else
    runlog_step "$1 ${2:-}" "$@"
  fi
}

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  usage
  exit 0
fi

require_command git

script_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
prompt_file="$script_dir/git_mf.prompt.md"

# The run log is optional: without it, every runlog_* call does nothing.
runlog_sh="$script_dir/../runlog/runlog.sh"
# `ud runs`, called directly: its tap and redact-file run in the agent path.
runs_cli="${BOKU_RUNS_CLI:-$script_dir/../runlog/cli.ts}"
if [[ -r "$runlog_sh" ]]; then
  # shellcheck source=../runlog/runlog.sh
  source "$runlog_sh" || true
fi
if ! declare -F runlog_start >/dev/null; then
  runlog_start() { :; }
  runlog_active() { return 1; }
  runlog_event() { :; }
  runlog_step() { shift; "$@"; }
  runlog_artifact() { :; }
  runlog_end() { :; }
  runlog_dir() { return 1; }
  runlog_file() { return 1; }
fi
if ! declare -F runlog_trap_signals >/dev/null; then
  # Exit with 128+N on a signal, so the EXIT handler records the real code.
  runlog_trap_signals() {
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  }
fi

target=""
use_agent=0
merge_flags=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --agent) use_agent=1 ;;
    --json) json_out=1; export BOKU_RUNLOG_STDOUT=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [[ -z "$target" && "$arg" != -* ]]; then
        target="$arg"
      else
        merge_flags+=("$arg")
      fi
      ;;
  esac
done

merge_log=""
prompt_tmp=""
status=""

# One exit handler: clean up temp files and close the run with its status.
on_exit() {
  local -r code=$?
  [[ -n "$merge_log" ]] && rm -f -- "$merge_log"
  [[ -n "$prompt_tmp" ]] && rm -f -- "$prompt_tmp"
  runlog_end "$code" ${status:+status="$status"}
}

runlog_start git_mf "$@"
trap on_exit EXIT
runlog_trap_signals

if [[ -z "$target" ]]; then
  # Failures here never failed git_mf; they're warnings in the run log.
  run git fetch --all --prune \
    || runlog_event warn code=fetch-failed msg="git fetch --all failed"
  run git pull \
    || runlog_event warn code=pull-failed msg="git pull failed"
  exit 0
fi

repo="$(git rev-parse --show-toplevel)"
upstream="origin/$target"
upstream_sha=""

# ---- Agent hand-off ----
# run_agent writes the prompt, runs the agent (through the run log's tap when
# it can), then checks the repository itself instead of trusting the agent's
# exit code. It returns git_mf's exit code; on_exit closes the run.

agent=""
agent_status=0
session_id=""
cli_version=""
run_dir=""
prompt_path=""
head_before=""
stash_before=0
clean_before=0
outcome=""
code=0
challenges=""

# Write the prompt and this run's context. With the run log on, it's saved
# as the run's prompt.md artifact (redacted, 0600); otherwise a temp file.
write_prompt() {
  local -r reason="$1"
  run_dir="$(runlog_dir)" || run_dir=""
  prompt_tmp="$(mktemp --suffix=.md)"
  prompt_path="$prompt_tmp"
  {
    cat "$prompt_file"
    printf '%s\n' "" "## This Run" "" \
      "- Repository: $repo" \
      "- Merge from: $upstream${upstream_sha:+ ($upstream_sha)}" \
      "- Current branch: $(git branch --show-current)" \
      "- Why plain git stopped: $reason"
  } >"$prompt_path"
  if [[ -n "$run_dir" ]]; then
    runlog_artifact prompt "$prompt_tmp"
    [[ -s "$run_dir/prompt.md" ]] && prompt_path="$run_dir/prompt.md"
  fi
}

record_before() {
  head_before="$(git rev-parse HEAD)"
  stash_before="$(git stash list | wc -l)"
  clean_before=0
  [[ -z "$(git status --porcelain)" ]] && clean_before=1
  cli_version="$("$agent" --version 2>/dev/null | head -n 1 || true)"
}

# --strict-mcp-config with no --mcp-config: the merge needs no MCP servers,
# and loading them all adds seconds before the agent starts.
claude_args=(
  -p --strict-mcp-config --permission-mode acceptEdits
  --allowedTools "Bash(git:*)" "Bash(just:*)" "Bash(bun:*)"
  "Bash(cargo:*)" "Read" "Edit" "Write" "Grep" "Glob"
)
codex_args=(exec -C "$repo" -s workspace-write --approve-for-me)

# Run the agent through `ud runs tap`, which saves and summarizes its stream.
run_stream_pipeline() {
  set +e
  if [[ "$agent" == claude ]]; then
    session_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null)"
    claude "${claude_args[@]}" ${session_id:+--session-id "$session_id"} \
      --output-format stream-json --verbose <"$prompt_path" \
      | { "$runs_cli" tap --cli claude ${session_id:+--session-id "$session_id"} \
          || { runlog_event warn code=tap-exited; cat >/dev/null; }; }
    agent_status="${PIPESTATUS[0]}"
  else
    codex "${codex_args[@]}" --json -o "$run_dir/report.md" <"$prompt_path" \
      | { "$runs_cli" tap --cli codex \
          || { runlog_event warn code=tap-exited; cat >/dev/null; }; }
    agent_status="${PIPESTATUS[0]}"
  fi
  set -e
  if [[ "$agent" == codex ]]; then
    if [[ -s "$run_dir/report.md" ]]; then
      "$runs_cli" redact-file "$run_dir/report.md" || true
    fi
    local run_file
    if run_file="$(runlog_file)"; then
      session_id="$(jq -r 'select(.event == "agent-session")
        | .session_id // empty' "$run_file" 2>/dev/null | tail -n 1 || true)"
    fi
  fi
}

# Today's command, with the agent's own text output.
run_plain_agent() {
  local -a agent_cmd
  if [[ "$agent" == claude ]]; then
    agent_cmd=(claude "${claude_args[@]}")
  else
    agent_cmd=(codex "${codex_args[@]}" ${run_dir:+-o "$run_dir/report.md"})
  fi
  set +e
  if (( json_out )); then
    # Keep stdout JSONL: the agent's text goes to stderr.
    "${agent_cmd[@]}" <"$prompt_path" >&2
  else
    "${agent_cmd[@]}" <"$prompt_path"
  fi
  agent_status=$?
  set -e
}

# Decide the outcome from the repository, per the verify table in
# docs/run-log-design.md.
verify() {
  local op moved=0 contains=0 head_after
  head_after="$(git rev-parse HEAD)"
  [[ "$head_after" != "$head_before" ]] && moved=1
  op="$(in_progress_op)"
  if [[ -n "$op" ]]; then
    outcome=stopped code=5 status=stopped
    runlog_event error code=agent-left-merge \
      msg="a $op is still in progress after the agent exited"
  else
    if [[ -n "$upstream_sha" ]]; then
      if is_ancestor "$upstream_sha" HEAD; then contains=1; fi
    else
      runlog_event warn code=upstream-unknown \
        msg="no upstream commit to check; judging by HEAD alone"
      contains="$moved"
    fi
    if (( agent_status == 0 )); then
      if (( contains && moved )); then
        outcome=merged code=0 status=ok
      elif (( contains )); then
        outcome=no-change code=0 status=ok
      elif (( ! moved )); then
        outcome=no-change code=3 status=stopped
      else
        outcome=failed code=1 status=failed
      fi
    elif (( contains && moved )); then
      outcome=merged code=0 status=ok
      runlog_event warn code=agent-exit-nonzero \
        msg="agent exited $agent_status but the merge landed"
    else
      outcome=failed code=1 status=failed
    fi
  fi
  if [[ "$outcome" != stopped ]] && (( clean_before )) \
    && [[ -n "$(git status --porcelain)" ]]; then
    runlog_event warn code=agent-left-changes \
      msg="the tree was clean before the agent and isn't now"
  fi
  if (( $(git stash list | wc -l) > stash_before )); then
    runlog_event warn code=agent-left-stash msg="the stash grew during the run"
  fi
}

# Paths whose contents never go into a saved diff.
# '*.env*' also matches .env, .envrc, .env-prod, and app.env.local.
secret_excludes=(
  . ':(exclude,glob)**/secrets/**' ':(exclude,glob)**/*.env*'
)

# Check the report and save the diffs that show what the agent decided.
save_artifacts() {
  local report="" tmp
  runlog_active || return 0
  if [[ -n "$run_dir" && -s "$run_dir/report.md" ]]; then
    # Redact (and chmod 0600) in place, whoever wrote it: the tap, or codex
    # through -o. The writer falls back to jq if `ud runs` can't.
    runlog_artifact report "$run_dir/report.md"
    report="$run_dir/report.md"
  fi
  if [[ -z "$report" ]]; then
    runlog_event warn code=report-missing msg="the agent left no report"
  elif ! grep -q '^## Challenges' "$report"; then
    runlog_event warn code=report-missing-challenges \
      msg="the report has no Challenges section"
  else
    challenges="$(awk '/^## Challenges/ { f = 1; next } /^## / { f = 0 }
      f && !started && /^[[:space:]]*$/ { next }
      f { started = 1; print }' "$report" | head -c 512)"
  fi
  tmp="$(mktemp)"
  if [[ "$outcome" == merged ]] \
    && git rev-parse -q --verify HEAD^2 >/dev/null 2>&1; then
    git show --remerge-diff --format= HEAD -- "${secret_excludes[@]}" \
      >"$tmp" 2>/dev/null || true
    runlog_artifact remerge-diff "$tmp"
  elif [[ "$outcome" == stopped ]]; then
    git diff -- "${secret_excludes[@]}" >"$tmp" 2>/dev/null || true
    runlog_artifact conflict-diff "$tmp"
  fi
  rm -f -- "$tmp"
}

# Hand the merge to an agent CLI. Returns git_mf's exit code.
run_agent() {
  local -r reason="$1"
  local t0
  if command -v claude >/dev/null 2>&1; then
    agent=claude
  elif command -v codex >/dev/null 2>&1; then
    agent=codex
  else
    say "neither claude nor codex is installed (repair: just sync)"
    exit 1
  fi
  if (( dry_run )); then
    echo "RUN $agent < git_mf.prompt.md  # $reason" >&2
    runlog_event step name=agent msg=dry-run cli="$agent"
    exit 0
  fi
  write_prompt "$reason"
  record_before
  say "handing the merge to $agent"
  t0="$(date +%s%3N)"
  if runlog_active && [[ -n "$run_dir" ]] \
    && [[ -x "$runs_cli" ]]; then
    run_stream_pipeline
  else
    run_plain_agent
  fi
  verify
  save_artifacts
  runlog_event agent cli="$agent" cli_version="$cli_version" \
    session_id="$session_id" exit:="$agent_status" \
    dur_ms:="$(( $(date +%s%3N) - t0 ))" outcome="$outcome" \
    challenges="$challenges"
  if [[ -n "$run_dir" && -s "$run_dir/report.md" ]]; then
    echo "----- agent report ($run_dir/report.md) -----" >&2
    cat "$run_dir/report.md" >&2
    echo "-----" >&2
  fi
  say "agent outcome: $outcome (git_mf exits $code)"
  if [[ -n "$run_dir" ]]; then
    say "run log: ud runs show ${run_dir##*/}"
  fi
  return "$code"
}

# Stop with exit 3, or hand over to the agent.
needs_judgment() {
  local -r reason="$1"
  if (( use_agent )); then
    run_agent "$reason" || exit $?
    exit 0
  fi
  runlog_event warn code=needs-judgment msg="$reason"
  say "$reason"
  say "nothing was changed; run: git_mf $target --agent"
  exit 3
}

# Name an operation already in progress, if any.
in_progress_op() {
  local op path
  for op in MERGE_HEAD:merge rebase-merge:rebase rebase-apply:rebase \
    CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert; do
    path="$(git rev-parse --git-path "${op%%:*}")"
    if [[ -e "$path" ]]; then
      echo "${op#*:}"
      return
    fi
  done
}

is_ancestor() { git merge-base --is-ancestor "$1" "$2"; }

# The commit a merge would bring in: the upstream ref, else the local target.
resolve_upstream_sha() {
  git rev-parse -q --verify "$upstream^{commit}" 2>/dev/null \
    || git rev-parse -q --verify "$target^{commit}" 2>/dev/null \
    || true
}

# Print the arguments as a JSON array of strings; [] without jq.
json_array() {
  jq -nc '$ARGS.positional' --args "$@" 2>/dev/null || echo '[]'
}

# Log the plan as one step. Sets upstream_sha for verify.
log_plan() {
  local -r action="$1"
  shift
  upstream_sha="$(resolve_upstream_sha)"
  runlog_event step name=plan action="$action" target="$target" \
    upstream="$upstream" upstream_sha="$upstream_sha" \
    conflicts:="$(json_array "$@")"
}

# ---- Plan: read-only apart from fetching remote-tracking refs. ----

op="$(in_progress_op)"
if [[ -n "$op" ]]; then
  say "plan: in-progress: $op"
  log_plan "in-progress: $op"
  say "finish or abort the $op first"
  exit 5
fi

if [[ -n "$(git status --porcelain)" ]]; then
  say "plan: dirty"
  log_plan dirty
  if (( use_agent )); then
    run_agent "the working tree has uncommitted changes" || exit $?
    exit 0
  fi
  say "uncommitted changes in $repo; skipping"
  exit 2
fi

has_local_target=0
git show-ref --verify --quiet "refs/heads/$target" && has_local_target=1

echo "RUN git fetch --quiet --prune origin +refs/heads/$target:refs/remotes/$upstream" >&2
fetch_cmd=(git fetch --quiet --prune origin
  "+refs/heads/$target:refs/remotes/$upstream")
fetch_rc=0
fetch_t0="$(date +%s%3N)"
"${fetch_cmd[@]}" 2>/dev/null || fetch_rc=$?
runlog_event step name=fetch-target cmd:="$(json_array "${fetch_cmd[@]}")" \
  exit:="$fetch_rc" dur_ms:="$(( $(date +%s%3N) - fetch_t0 ))" \
  ref="$upstream"
if (( fetch_rc == 0 )); then
  :
elif (( has_local_target )); then
  say "origin has no $target; merging the local branch"
  upstream="$target"
else
  say "plan: missing-target"
  log_plan missing-target
  say "no branch $target on origin or locally"
  exit 1
fi

branch="$(git branch --show-current)"
steps=()

# Keep a local target you aren't on current, as the old checkout-and-pull did.
# A detached checkout switches to the target instead.
if (( has_local_target )) && [[ -n "$branch" && "$branch" != "$target" \
  && "$upstream" != "$target" ]]; then
  if is_ancestor "$target" "$upstream"; then
    if [[ "$(git rev-parse "$target")" != "$(git rev-parse "$upstream")" ]]; then
      steps+=("update-local-target")
    fi
  else
    say "local $target has commits that $upstream doesn't; merging $upstream only"
  fi
fi

if [[ -z "$branch" ]]; then
  if ! is_ancestor HEAD "$upstream"; then
    say "plan: detached-stray"
    log_plan detached-stray
    say "detached at $(git rev-parse --short HEAD), which isn't on $upstream; switch to a branch first"
    exit 4
  fi
  if (( has_local_target )) && ! is_ancestor "$target" "$upstream"; then
    say "plan: diverged"
    log_plan diverged
    needs_judgment "$target has commits that $upstream doesn't, and the reverse"
  fi
  steps+=("detached-switch")
  # After the switch, HEAD is the local target (or upstream for a new branch).
  if (( has_local_target )); then head_ref="$target"; else head_ref="$upstream"; fi
  branch="$target"
else
  head_ref=HEAD
fi

conflicts=""
if is_ancestor "$upstream" "$head_ref"; then
  action="up-to-date"
elif is_ancestor "$head_ref" "$upstream"; then
  action="fast-forward"
elif [[ "$branch" == "$target" ]]; then
  action="diverged"
else
  # Exit 0: clean merge. Exit 1: conflicts, listed after the tree id.
  # Anything else is an error, such as unrelated histories.
  tree_status=0
  tree_out="$(git merge-tree --write-tree --name-only --no-messages \
    "$head_ref" "$upstream" 2>&1)" || tree_status=$?
  case "$tree_status" in
    0) action="merge" ;;
    1)
      action="merge-conflict"
      conflicts="$(tail -n +2 <<<"$tree_out" | sed '/^$/d' | sort -u | paste -sd ' ' -)"
      ;;
    *)
      say "plan: error"
      log_plan error
      runlog_event error code=merge-tree-failed msg="$tree_out"
      say "git merge-tree failed: $tree_out"
      exit 1
      ;;
  esac
fi

steps+=("$action")
say "plan: ${steps[*]}${conflicts:+: $conflicts}"
# shellcheck disable=SC2086 # conflicts is a space-separated file list
log_plan "${steps[*]}" $conflicts

case "$action" in
  diverged)
    needs_judgment "$target has commits that $upstream doesn't, and the reverse" ;;
  merge-conflict)
    needs_judgment "merging $upstream into $branch conflicts in: $conflicts" ;;
esac

# ---- Apply ----

for step in "${steps[@]}"; do
  case "$step" in
    detached-switch)
      if (( has_local_target )); then
        run git switch --quiet "$target"
      else
        run git switch --quiet --create "$target" --track "$upstream"
      fi
      ;;
  esac
done

case "$action" in
  up-to-date)
    say "$branch already includes $upstream"
    ;;
  fast-forward)
    run git merge --ff-only --quiet "$upstream"
    ;;
  merge)
    # --ff overrides a merge.ff=only setting, which would refuse this merge.
    merge_cmd=(git merge --ff --no-edit --quiet "${merge_flags[@]}" "$upstream")
    echo "RUN ${merge_cmd[*]}" >&2
    merge_log="$(mktemp)"
    merge_rc=0
    if (( dry_run )); then
      runlog_event step name="git merge" msg=dry-run
    else
      merge_t0="$(date +%s%3N)"
      "${merge_cmd[@]}" >"$merge_log" 2>&1 || merge_rc=$?
      runlog_event step name="git merge" \
        cmd:="$(json_array "${merge_cmd[@]}")" exit:="$merge_rc" \
        dur_ms:="$(( $(date +%s%3N) - merge_t0 ))"
    fi
    if (( merge_rc != 0 )); then
      unmerged="$(git diff --name-only --diff-filter=U | paste -sd ' ' -)"
      if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
        git merge --abort
      fi
      if [[ -n "$unmerged" ]]; then
        say "warning: plan predicted a clean merge, but git found conflicts"
        needs_judgment "merging $upstream into $branch conflicts in: $unmerged"
      fi
      runlog_event error code=merge-failed msg="$(head -c 400 "$merge_log")"
      say "merge failed without conflicts; nothing was changed:"
      cat "$merge_log" >&2
      exit 1
    fi
    ;;
esac

# Only after the merge succeeded, so a failed run changes nothing.
if [[ " ${steps[*]} " == *" update-local-target "* ]]; then
  run git fetch --quiet . "$upstream:$target"
fi

(( dry_run )) && exit 0
say "$branch is at $(git rev-parse --short HEAD), including $upstream ($(git rev-parse --short "$upstream"))"
