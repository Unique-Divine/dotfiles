#!/usr/bin/env python3
"""Publish and list public files using the personal gcloud login."""
import argparse
import base64
import datetime
import hashlib
import html
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from zoneinfo import ZoneInfo

MAX_BYTES = 256 * 1024 * 1024
INLINE = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg",
          "gif": "image/gif", "webp": "image/webp", "avif": "image/avif", "pdf": "application/pdf"}
IMAGES = set(INLINE) - {"pdf"}
LIST_FIELDS = ("key", "url", "size", "contentType")


def public_url(key, base_url):
    parsed = urllib.parse.urlsplit(base_url)
    if (parsed.scheme != "https" or not parsed.netloc or parsed.query
            or parsed.fragment or parsed.username
            or parsed.path not in {"", "/"}):
        raise ValueError("Base URL must be an HTTPS origin")
    return base_url.rstrip("/") + "/f/" + urllib.parse.quote(key, safe="/")


def safe_key(key):
    return (isinstance(key, str) and 0 < len(key) <= 1024
            and all(re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", part)
                    and ".." not in part for part in key.split("/")))


def directory_prefix(directory):
    if not directory:
        return ""
    path = directory[:-1] if directory.endswith("/") else directory
    if not safe_key(path):
        raise ValueError("Directory must be a safe relative path")
    return path + "/"

def settings():
    root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    values = {}
    for config in [root / "pub/config.json", root / "ud/fs/config.json"]:
        if config.exists():
            loaded = json.loads(config.read_text())
            if not isinstance(loaded, dict):
                raise ValueError(f"Configuration must be a JSON object: {config}")
            values.update(loaded)
    return {
        "base_url": os.environ.get(
            "UD_FS_BASE_URL", os.environ.get(
                "PUB_BASE_URL", values.get("base_url", "https://uniquedivine.com"))),
        "bucket": os.environ.get(
            "UD_FS_BUCKET", os.environ.get(
                "PUB_BUCKET", values.get("bucket", "uniquedivine-public-files-876932632137"))),
        "project": "exalted-justice-359714", "account": "realuniquedivine@gmail.com",
    }

def destination_name(file, slug):
    parts = slug.split("/")
    for part in parts[:-1]:
        if len(part) > 80 or not re.fullmatch(
                r"[a-z0-9]+(?:-[a-z0-9]+)*", part):
            raise ValueError("Directories must use lowercase names, digits, "
                             "and single hyphens")
    name, separator, extension = parts[-1].partition(".")
    if len(name) > 80 or not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
        raise ValueError("Slug must contain lowercase letters, digits, and single hyphens, up to 80 characters")
    suffix = "." + extension.lower() if separator else Path(file).suffix.lower()
    if suffix and not re.fullmatch(r"(?:\.[a-z0-9]+)+", suffix):
        raise ValueError("Unsupported file extension")
    return "/".join(parts[:-1] + [name]), suffix

def plan(file, slug, date=None, base_url="https://uniquedivine.com"):
    file = Path(file).resolve(strict=True)
    if not file.is_file(): raise ValueError("Input must be a regular file")
    if file.stat().st_size > MAX_BYTES: raise ValueError("File exceeds 256 MiB")
    name, suffix = destination_name(file, slug)
    timestamp = re.fullmatch(r"(\d{8})-\d{6}", file.stem)
    if date is not None:
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date): raise ValueError("Date must use YYYY-MM-DD")
        day = datetime.date.fromisoformat(date)
    elif timestamp:
        day = datetime.datetime.strptime(timestamp[1], "%Y%m%d").date()
    else:
        day = datetime.datetime.now(ZoneInfo("Asia/Bangkok")).date()
    parent, _, leaf = name.rpartition("/")
    key = (day.strftime("%y/") + (parent + "/" if parent else "")
           + day.strftime("%y%m%d") + "-" + leaf + suffix)
    if len(key) > 1024:
        raise ValueError("Destination path exceeds 1024 characters")
    return file, key, public_url(key, base_url)


def normalize_object(value, base_url):
    """Project GCS metadata into the CLI's provider-independent record."""
    key = value.get("name")
    if not safe_key(key):
        return None
    size = value.get("size")
    if isinstance(size, bool) or not re.fullmatch(r"[0-9]+", str(size)):
        raise ValueError("Storage returned invalid file size metadata")
    content_type = value.get("contentType") or "application/octet-stream"
    if not isinstance(content_type, str):
        raise ValueError("Storage returned invalid content type metadata")
    return {"key": key, "url": public_url(key, base_url),
            "size": int(size), "contentType": content_type}


class GcsBackend:
    """Keep cloud authentication and transfer details out of CLI formatting."""

    def __init__(self, config):
        self.config = config

    def upload(self, file, key, digest):
        extension = Path(key).suffix.lstrip(".")
        disposition = "inline" if extension in INLINE else "attachment"
        return subprocess.run([
            "gcloud", "storage", "cp", str(file),
            f"gs://{self.config['bucket']}/{key}",
            "--project", self.config["project"],
            "--account", self.config["account"],
            "--if-generation-match=0", "--content-md5=" + digest,
            "--cache-control=public,max-age=300,no-transform",
            "--content-type=" + INLINE.get(extension,
                                          "application/octet-stream"),
            f'--content-disposition={disposition}; filename="{Path(key).name}"',
        ], stdout=sys.stderr).returncode

    def list_files(self, prefix, page_size=1000):
        config = self.config
        public_url("validation", config["base_url"])
        if not shutil.which("gcloud"):
            raise ValueError("gcloud is required")
        if not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", config["bucket"]):
            raise ValueError("Bucket must be a Google Storage bucket name")
        result = subprocess.run([
            "gcloud", "auth", "print-access-token",
            "--account", config["account"], "--project", config["project"],
        ], text=True, capture_output=True)
        if result.returncode or not result.stdout.strip():
            raise ValueError("Google authentication failed. Sign in with "
                             "gcloud auth login " + config["account"])
        token = result.stdout.strip()
        records, seen_tokens = {}, set()
        cursor = None
        skipped = 0
        while True:
            query = {"prefix": prefix, "maxResults": page_size,
                     "fields": "items(name,size,contentType),nextPageToken"}
            if cursor:
                query["pageToken"] = cursor
            url = ("https://storage.googleapis.com/storage/v1/b/"
                   + urllib.parse.quote(config["bucket"], safe="")
                   + "/o?" + urllib.parse.urlencode(query))
            request = urllib.request.Request(
                url, headers={"Authorization": "Bearer " + token})
            with urllib.request.urlopen(request, timeout=30) as response:
                page = json.load(response)
            items = page.get("items", [])
            if not isinstance(items, list):
                raise ValueError("Storage returned an invalid listing")
            for item in items:
                record = normalize_object(item, config["base_url"])
                if record is None:
                    skipped += 1
                else:
                    records[record["key"]] = record
            cursor = page.get("nextPageToken")
            if not cursor:
                break
            if not isinstance(cursor, str) or cursor in seen_tokens:
                raise ValueError("Storage returned invalid pagination")
            seen_tokens.add(cursor)
        if skipped:
            print(f"Skipped {skipped} folder markers or names unsupported "
                  "by the public file server.", file=sys.stderr)
        return [records[key] for key in sorted(records)]


def toon_string(value):
    """Encode string cells under TOON 4.4 comma-delimited quoting rules."""
    quote = (not value or value.strip(" \t") != value
             or value in {"true", "false", "null"}
             or re.fullmatch(r"[+-]?[0-9]+(?:\.[0-9]+)?(?:e[+-]?[0-9]+)?",
                             value, re.IGNORECASE)
             or any(char in value for char in ':"\\[]{},')
             or any(ord(char) < 32 for char in value)
             or value.startswith(("-", "#")))
    if not quote:
        return value
    escapes = {"\\": "\\\\", '"': '\\"', "\n": "\\n",
               "\r": "\\r", "\t": "\\t"}
    return '"' + "".join(
        escapes.get(char, f"\\u{ord(char):04x}" if ord(char) < 32 else char)
        for char in value) + '"'


def listing_output(records, mode="toon"):
    if mode == "json":
        return json.dumps({"files": records}, ensure_ascii=False, indent=2)
    if mode in {"urls", "paths"}:
        field = "url" if mode == "urls" else "key"
        return "\n".join(record[field] for record in records)
    if not records:
        return "files: []"
    lines = [f"files[{len(records)}]{{{','.join(LIST_FIELDS)}}}:"]
    for record in records:
        cells = [str(record[field]) if field == "size"
                 else toon_string(record[field]) for field in LIST_FIELDS]
        lines.append("  " + ",".join(cells))
    return "\n".join(lines)

def verify(url, expected_size):
    for attempt in range(5):
        try:
            request = urllib.request.Request(url, method="HEAD")
            with urllib.request.urlopen(request, timeout=30) as response:
                if response.status != 200 or int(response.headers.get("Content-Length", "-1")) != expected_size:
                    raise ValueError("Public response has unexpected status or size")
                return
        except (urllib.error.URLError, ValueError):
            if attempt == 4: raise
            time.sleep(1 + attempt)

def publish(args, config):
    file, key, url = plan(args.file, args.slug, args.date, config["base_url"])
    extension = Path(key).suffix.lstrip(".")
    text = url
    if args.md:
        label = Path(destination_name(file, args.slug)[0]).name.replace('-', ' ')
        text = (f'<img src="{html.escape(url, quote=True)}" alt="{html.escape(label, quote=True)}" />'
                if extension in IMAGES else f"[{label}]({url})")
    if args.dry_run:
        print(text); return 0
    if not shutil.which("gcloud"): raise ValueError("gcloud is required")
    # The MD5 precondition detects a file changing between validation and upload.
    digest = hashlib.md5()
    with file.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""): digest.update(chunk)
    if GcsBackend(config).upload(
            file, key, base64.b64encode(digest.digest()).decode()):
        raise ValueError("Upload failed. Existing names are never overwritten; use a different slug for another version")
    try: verify(url, file.stat().st_size)
    except Exception as error:
        raise ValueError(f"Uploaded {key}, but public verification failed: {error}. The object remains in storage") from error
    print(text, flush=True)
    if not args.no_clipboard:
        clipboard = shutil.which("clip.exe") or shutil.which("pbcopy")
        if clipboard:
            try:
                subprocess.run([clipboard], input=text.encode(), check=True, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                print("Published successfully; clipboard copy failed. Use the output above.", file=sys.stderr)
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ["--plugin-info"]:
        print(json.dumps({"apiVersion": 1, "name": "fs",
                          "description": "Publish and list public files"}))
        return 0
    parser = argparse.ArgumentParser(
        prog="ud fs", description="Publish and list files on uniquedivine.com.")
    commands = parser.add_subparsers(dest="command")
    upload = commands.add_parser("publish", help="Publish a named local file",
                                 description="Publish at /f/YY/DIRS/YYMMDD-name.ext.")
    upload.add_argument("file")
    upload.add_argument("slug", help="Name with optional directories and extension")
    upload.add_argument("--date", help="Override date using YYYY-MM-DD")
    upload.add_argument("--md", action="store_true",
                        help="Print/copy an HTML img tag or Markdown file link")
    upload.add_argument("--no-clipboard", action="store_true")
    upload.add_argument("--dry-run", action="store_true",
                        help="Validate and print without uploading or signing in")
    listing = commands.add_parser("ls", help="List remote files; defaults to TOON")
    listing.add_argument("directory", nargs="?", default="",
                         help="Relative directory to list recursively")
    formats = listing.add_mutually_exclusive_group()
    for flag, help_text in [("json", "Print structured JSON"),
                            ("urls", "Print one public URL per line"),
                            ("paths", "Print one object path per line")]:
        formats.add_argument("--" + flag, dest="format", action="store_const",
                             const=flag, help=help_text)
    listing.set_defaults(format="toon")
    if argv and argv[0] not in {"publish", "ls", "-h", "--help"}:
        parser.error("Use 'ud fs publish FILE NAME' to publish a file")
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    config = settings()
    if args.command == "publish":
        return publish(args, config)
    prefix = directory_prefix(args.directory)
    records = GcsBackend(config).list_files(prefix)
    output = listing_output(records, args.format)
    if output:
        print(output)
    return 0

if __name__ == "__main__":
    try: sys.exit(main())
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print("ERROR: " + str(error), file=sys.stderr); sys.exit(1)
