test:
    cargo test --locked

lint:
    cargo fmt --check
    cargo clippy --all-targets --locked -- -D warnings

build:
    cargo build --release --locked

install:
    cargo install --path . --locked --root "$HOME/.local" --force

# Build and register the source checkout with Herdr.
plugin-link: build
    herdr plugin link "{{justfile_directory()}}"

# Check the crate and verify the publishable package without publishing.
release-check: test lint
    cargo package --locked
    cargo publish --dry-run --locked
