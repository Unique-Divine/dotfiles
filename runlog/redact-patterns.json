  { "kind": "password-value", "regex": "(?<=password=)(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff&\"'\\\\]+|(?:(?<=password=\")|(?<=password=\\\\\"))(?!\\[redacted:)[^\"\\\\\\n\\r\u0085\u2028\u2029]+|(?:(?<=password=')|(?<=password=\\\\'))(?!\\[redacted:)[^'\\\\\\n\\r\u0085\u2028\u2029]+" },
  { "kind": "api-key-value", "regex": "(?<=api_key=)(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff&\"'\\\\]+|(?:(?<=api_key=\")|(?<=api_key=\\\\\"))(?!\\[redacted:)[^\"\\\\\\n\\r\u0085\u2028\u2029]+|(?:(?<=api_key=')|(?<=api_key=\\\\'))(?!\\[redacted:)[^'\\\\\\n\\r\u0085\u2028\u2029]+" },
  { "kind": "token-json", "regex": "(?:(?<=token\":\")|(?<=token\": \"))(?!\\[redacted:)(?:[^\"\\\\\\n]|\\\\[^\\n])+|(?:(?<=token\\\\\":\\\\\")|(?<=token\\\\\": \\\\\"))(?!\\[redacted:)[^\"\\\\\\n]+" },
