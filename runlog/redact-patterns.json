  { "kind": "secret-value", "regex": "(?:(?<=secret=)|(?<=secret=[\"']))(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r &\"'\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+" },
  { "kind": "secret-key-value", "regex": "(?:(?<=secret_key=)|(?<=secret_key=[\"']))(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r &\"'\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+" },
  { "kind": "password-value", "regex": "(?:(?<=password=)|(?<=password=[\"']))(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r &\"'\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+" },
  { "kind": "api-key-value", "regex": "(?:(?<=api_key=)|(?<=api_key=[\"']))(?!\\[redacted:)[^\\t\\n\\x0b\\f\\r &\"'\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+" },
  { "kind": "token-json", "regex": "(?:(?<=token\":\")|(?<=token\": \"))(?!\\[redacted:)(?:[^\"\\\\\\n]|\\\\[^\\n])+|(?:(?<=token\\\\\":\\\\\")|(?<=token\\\\\": \\\\\"))(?!\\[redacted:)[^\"\\\\\\n]+" },
  { "kind": "secret-json", "regex": "(?:(?<=secret\":\")|(?<=secret\": \"))(?!\\[redacted:)(?:[^\"\\\\\\n]|\\\\[^\\n])+|(?:(?<=secret\\\\\":\\\\\")|(?<=secret\\\\\": \\\\\"))(?!\\[redacted:)[^\"\\\\\\n]+" },
  { "kind": "password-json", "regex": "(?:(?<=password\":\")|(?<=password\": \"))(?!\\[redacted:)(?:[^\"\\\\\\n]|\\\\[^\\n])+|(?:(?<=password\\\\\":\\\\\")|(?<=password\\\\\": \\\\\"))(?!\\[redacted:)[^\"\\\\\\n]+" },
  { "kind": "api-key-json", "regex": "(?:(?<=api_key\":\")|(?<=api_key\": \"))(?!\\[redacted:)(?:[^\"\\\\\\n]|\\\\[^\\n])+|(?:(?<=api_key\\\\\":\\\\\")|(?<=api_key\\\\\": \\\\\"))(?!\\[redacted:)[^\"\\\\\\n]+" }
]
