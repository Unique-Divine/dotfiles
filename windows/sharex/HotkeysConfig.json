{
  "ApplicationVersion": "19.0.2",
  "Hotkeys": [
    {
      "HotkeyInfo": {
        "Hotkey": "F2, Control",
        "Win": false
      },
      "TaskSettings": {
        "Description": "Audio Virtual Record",
        "Job": "ScreenRecorderActiveWindow",
        "UseDefaultCaptureSettings": false,
        "CaptureSettings": {
          "FFmpegOptions": {
            "AudioSource": "virtual-audio-capturer",
            "AudioCodec": "libmp3lame",
            "UseCustomCommands": false,
            "CustomCommands": "-f dshow -thread_queue_size 1024 -rtbufsize 256M -audio_buffer_size 80 -i audio=\"virtual-audio-capturer\" -c:a libmp3lame -qscale:a 4 -y \"output.mp3\""
          }
        }
      }
    }
  ]
}
